[configuration]

entry_symbol = "breakpoint_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

# AUD-12: only the template_debug DLL is built (tools/build_bridge.ps1); a
# template_release line would point at a file that never exists.
windows.debug.x86_64 = "res://bin/breakpoint_bridge.windows.template_debug.x86_64.dll"
